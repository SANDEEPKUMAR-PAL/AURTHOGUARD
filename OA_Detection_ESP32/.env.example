# SIH26004 OA Risk Detection Backend Configuration Reference Template
# All parameters can be overridden via environment variables with prefix OA_

# Server & Networking
OA_HOST=0.0.0.0
OA_PORT=8000
OA_DB_PATH=data/oa_system.db
OA_MODEL_PATH=data/oa_risk_model.joblib
OA_DEFAULT_LAN_IP=127.0.0.1
OA_ESP32_PULL_BRIDGE_PORT=81
OA_BRIDGE_RECONNECT_DELAY_SEC=3.0
OA_SIMULATOR_DEFAULT_HZ=10.0
OA_HTTP_HEARTBEAT_TIMEOUT_SEC=5.0

# Hardware Pin Allocations (ESP32)
OA_PIN_SDA=21
OA_PIN_SCL=22
OA_PIN_FLEX=32
OA_PIN_FSR_HEEL=34
OA_PIN_FSR_FORE=35
OA_PIN_GREEN_LED=26
OA_PIN_RED_LED=27
OA_PIN_BUZZER=25

# I2C Bus Addresses
OA_IMU_THIGH_I2C_ADDR=104  # 0x68
OA_IMU_SHIN_I2C_ADDR=105   # 0x69

# Sensor Rail Bounds & Hardware Sanity Limits
OA_IMU_ACCEL_MIN_G=0.25
OA_IMU_ACCEL_MAX_G=4.5
OA_FLEX_OPEN_CIRCUIT_ADC=15
OA_FLEX_SHORTED_ADC=4085
OA_FSR_SATURATED_ADC=4088
OA_FSR_LOADED_MIN_ADC=80

# Clinical Knee Flexion & Plantar Limits (AAOS Goniometry + Gait Literature)
# 0° = straight standing, 90° = seated bend, -10° = hyperextension, 135° = hyperflexion
OA_KNEE_ANGLE_MIN=-10.0
OA_KNEE_ANGLE_MAX=135.0
OA_FSR_IMBALANCE_THRESH=60.0
OA_FLEX_STIFF_THRESH=0.25
OA_VARUS_VELOCITY_THRESH=28.1
OA_VARUS_WOBBLE_THRESH=6.5
OA_BILATERAL_ROM_ASYMMETRY_THRESH=8.0
OA_BILATERAL_RISK_DIFF_THRESH=15.0
OA_EXTREME_ANGLE_MARGIN=5.0

# Biomechanical Force Divisors & Boundaries
OA_FSR_IMBALANCE_WARNING_THRESH=30.0
OA_FSR_FORCE_SCALE_DIVISOR=40.95
OA_FSR_TOTAL_LOAD_DIVISOR=64.0

# Calibration & Sampling Defaults
OA_CALIBRATION_TARGET_SAMPLES=20
OA_AUTO_CALIBRATION_SAMPLES=8
OA_CAL_FLEX_STRAIGHT_DEFAULT=2048
OA_CAL_FLEX_BENT_DEFAULT=1200

# AI Windowing (@ 10 Hz)
OA_AI_WINDOW_SIZE=40
OA_AI_STEP_INTERVAL=5

# SQLite Persistence
OA_DB_FLUSH_BATCH_SIZE=10

# Display & Reporting Timezone (default IST / Asia/Kolkata)
OA_DISPLAY_TIMEZONE=Asia/Kolkata
OA_DISPLAY_TIMEZONE_LABEL=IST
OA_TZ_OFFSET_MINUTES=330
